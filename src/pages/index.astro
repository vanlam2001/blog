---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const POSTS_PER_PAGE = 6;
const totalPages = Math.ceil(sortedPosts.length / POSTS_PER_PAGE);
const currentPage = 1;
const pagePosts = sortedPosts.slice(0, POSTS_PER_PAGE);
---

<BaseLayout title="VanLam" description="Blog bảo mật và chia sẻ kiến thức">
  {totalPages > 1 && (
    <nav class="pagination">
      <div class="pagination-left">
        <span class="pagination-info">Trang {currentPage}/{totalPages}</span>
      </div>
      <div class="pagination-right">
        <a
          class={`pagination-prev ${currentPage === 1 ? "disabled" : ""}`}
          href={currentPage === 1 ? "#" : `/page/${currentPage - 1}/`}
          aria-disabled={currentPage === 1}
        >
          ← Trang trước
        </a>
        <ul class="pagination-list">
          {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
            <li>
              {p === currentPage ? (
                <span class="pagination-link active">{p}</span>
              ) : (
                <a
                  class="pagination-link"
                  href={p === 1 ? "/" : `/page/${p}/`}
                >
                  {p}
                </a>
              )}
            </li>
          ))}
        </ul>
        <a
          class={`pagination-next ${currentPage === totalPages ? "disabled" : ""}`}
          href={currentPage === totalPages ? "#" : `/page/${currentPage + 1}/`}
          aria-disabled={currentPage === totalPages}
        >
          Trang sau →
        </a>
      </div>
    </nav>
  )}
  <section class="post-list">
    {pagePosts.map((post) => (
      <article class="post-card">
        {post.data.header?.teaser && (
          <a class="post-thumb" href={`/posts/${post.id}/`}>
            <img src={post.data.header.teaser} alt={post.data.title} loading="lazy" />
          </a>
        )}
        <div class="post-body">
          <h2 class="post-title">
            <a href={`/posts/${post.id}/`}>{post.data.title}</a>
          </h2>
          <div class="post-meta">
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString("vi-VN")}
            </time>
          </div>
          {post.data.description && <p class="post-excerpt">{post.data.description}</p>}
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
